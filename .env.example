# Sentinel backend configuration. Copy this file to .env (already
# gitignored — see .gitignore) and fill in real values there. Never commit
# a real API key; this file must only ever contain empty placeholders.
#
# See docs/architecture/ai_orchestrator.md "Provider abstraction" for the
# full provider-selection mechanism.

# Selects the AI Orchestrator's provider: "mock" (default, deterministic,
# no network calls — safe for local development and the test suite),
# "openai", or "featherless". Unset or any unrecognized value behaves like
# an explicit "mock" is the safe default; "openai"/"featherless" without
# their required variables below degrade to a clean "provider unavailable"
# response rather than crashing the backend.
SENTINEL_AI_PROVIDER=mock

# --- Real OpenAI provider (SENTINEL_AI_PROVIDER=openai) ---------------------
# OPENAI_API_KEY=
# SENTINEL_AI_MODEL=gpt-4o-mini

# --- Featherless.ai provider (SENTINEL_AI_PROVIDER=featherless) ------------
# Featherless hosts open-weight models (e.g. openai/gpt-oss-20b) behind an
# OpenAI-compatible Chat Completions API — Sentinel talks to it with the
# same `openai` SDK used for the real OpenAI provider, just pointed at a
# different base_url and model.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=openai/gpt-oss-20b

# --- CORS: deployed frontend origin(s) --------------------------------------
# Comma-separated list of additional origins allowed to call this API from a
# browser (e.g. a Render Static Site URL and/or a custom domain). Local
# development origins (localhost/127.0.0.1, any port) always work regardless
# of this variable — see backend/api/main.py. Leave unset until the frontend
# is actually deployed; never guess/hardcode a frontend URL here.
# SENTINEL_FRONTEND_ORIGINS=https://sentinel-dashboard.onrender.com
