# Base URL of the Sentinel backend API (see ../../backend and
# ../../scripts/run_backend.py). Copy this file to .env and adjust if your
# backend runs on a different port — port 8000 is sometimes already in use
# by another local process, in which case start the backend with
# `--port 8010` (or any free port) and match it here.
VITE_API_BASE_URL=http://127.0.0.1:8010
