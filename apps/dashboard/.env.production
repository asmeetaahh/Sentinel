# Loaded automatically by Vite only for production-mode builds (`vite build`,
# i.e. `npm run build`) — local development (`npm run dev`) is unaffected and
# keeps using ../.env (http://127.0.0.1:8010). See
# https://vite.dev/guide/env-and-mode for Vite's env-file precedence.
#
# This value is a public API base URL, not a secret, and is safe to commit.
# A Render environment variable named VITE_API_BASE_URL, if set on the
# Static Site's build environment, would still take precedence over this
# file if ever needed (e.g. to point a preview build at a different backend).
VITE_API_BASE_URL=https://sentinel-0sx6.onrender.com
